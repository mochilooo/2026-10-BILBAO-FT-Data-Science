-- 1.1
SELECT *
  FROM customers
 WHERE customers.Country = "Brazil";

-- 1.2
SELECT *
  FROM employees
 WHERE employees.Title = "Sales Support Agent";

-- 1.3
SELECT *
  FROM tracks
 WHERE tracks.Composer = "AC/DC";

-- 1.4
SELECT FirstName,
       LastName,
       CustomerId,
       Country
  FROM customers
 WHERE customers.Country != "USA";

-- 1.5
SELECT FirstName,
       LastName,
       City,
       State,
       Country,
       Email
  FROM employees
 WHERE employees.Title = "Sales Support Agent";

-- 1.6
SELECT DISTINCT BillingCountry
  FROM invoices;

-- 1.7
SELECT DISTINCT State,
                count(CustomerId) 
  FROM customers
 WHERE customers.Country == "USA"
 GROUP BY State;

-- 1.8
SELECT sum(Quantity) AS Numero_Articulos
  FROM invoice_items
 WHERE invoice_items.InvoiceId == 37;

-- 1.9
SELECT count(TrackId) AS Cantidad_Canciones
  FROM tracks AS t
 WHERE t.Composer = "AC/DC";

-- 1.10
SELECT InvoiceId,
       sum(Quantity)
  FROM invoice_items
 GROUP BY InvoiceId;

-- 1.11
SELECT BillingCountry,
       count(InvoiceId) 
  FROM invoices
 GROUP BY BillingCountry;

-- 1.12
SELECT strftime("%Y", invoicedate) AS anyo,
       count(InvoiceId) 
  FROM invoices
 WHERE anyo IN ("2009", "2011") 
 GROUP BY anyo;

-- 1.13
SELECT count(InvoiceId) AS Facturas_Totales
  FROM invoices
 WHERE strftime("%Y", invoicedate) BETWEEN ("2009") AND ("2011");

-- 1.14
SELECT Country,
       count(CustomerId) 
  FROM customers
 WHERE customers.Country IN ("Brazil", "Spain") 
 GROUP BY Country;

-- 1.15
SELECT *
  FROM tracks
 WHERE tracks.Name LIKE "You%";

-- 2.1
SELECT C.FirstName,
       InvoiceId,
       InvoiceDate,
       BillingCountry
  FROM invoices AS I
       INNER JOIN
       customers AS C ON C.CustomerId = I.CustomerId
 WHERE I.BillingCountry = "Brazil";

-- 2.2
SELECT DISTINCT employees.FirstName,
                employees.LastName,
                invoices.InvoiceId
  FROM employees
       INNER JOIN
       customers ON employees.EmployeeId = customers.SupportRepId
       INNER JOIN
       invoices ON customers.CustomerId = invoices.CustomerId
 WHERE employees.Title = "Sales Support Agent"
 ORDER BY employees.FirstName;

-- 2.3
SELECT DISTINCT customers.FirstName AS Nombre_Cliente,
                customers.Country AS Pais_Cliente,
                employees.FirstName AS Nombre_Trabajador,
                sum(invoices.Total) AS Total
  FROM customers
       INNER JOIN
       employees ON customers.SupportRepId = employees.EmployeeId
       INNER JOIN
       invoices ON customers.SupportRepId = invoices.CustomerId
 GROUP BY customers.CustomerId
 ORDER BY employees.FirstName;

-- 2.4
SELECT invoice_items.InvoiceId AS Artículo_Factura,
       tracks.Name AS Nombre_Canción
  FROM invoice_items
       INNER JOIN
       tracks ON invoice_items.TrackId = tracks.TrackId
 GROUP BY tracks.Name;

-- 2.5
SELECT DISTINCT tracks.Name AS Canción,
                media_types.Name AS Formato,
                albums.Title AS Album,
                genres.Name AS Genero
  FROM tracks
       INNER JOIN
       media_types ON media_types.MediaTypeId = tracks.MediaTypeId
       INNER JOIN
       albums ON albums.AlbumId = tracks.AlbumId
       INNER JOIN
       genres ON genres.GenreId = tracks.GenreId;

-- 2.6
SELECT playlists.Name,
       count(tracks.TrackId) 
  FROM playlist_track
       INNER JOIN
       playlists ON playlists.PlaylistId = playlist_track.PlaylistId
       INNER JOIN
       tracks ON playlist_track.TrackId = tracks.TrackId
 GROUP BY playlists.PlaylistId;

-- 2.7
SELECT employees.FirstName,
       sum(invoices.Total) 
  FROM employees
       INNER JOIN
       customers ON employees.EmployeeId = customers.SupportRepId
       INNER JOIN
       invoices ON customers.CustomerId = invoices.CustomerId
 GROUP BY employees.FirstName;

-- 2.8
SELECT strftime("%Y", invoices.InvoiceDate) AS anyo,
       employees.EmployeeId,
       employees.FirstName,
       sum(invoices.Total) AS Total_Vendido
  FROM employees
       INNER JOIN
       customers ON employees.EmployeeId = customers.SupportRepId
       INNER JOIN
       invoices ON customers.CustomerId = invoices.CustomerId
 WHERE anyo IN ("2009") AND
       employees.Title = "Sales Support Agent"
 GROUP BY employees.EmployeeId
 ORDER BY Total_Vendido DESC
 LIMIT 1;

-- 2.9
SELECT artists.Name,
       sum(invoice_items.Quantity) AS Total_Vendido
  FROM artists
       INNER JOIN
       albums ON artists.ArtistId = albums.ArtistId
       INNER JOIN
       tracks ON albums.AlbumId = tracks.AlbumId
       INNER JOIN
       invoice_items ON tracks.TrackId = invoice_items.TrackId
       INNER JOIN
       invoices ON invoice_items.InvoiceId = invoices.InvoiceId
 GROUP BY artists.ArtistId
 ORDER BY total_vendido DESC
 LIMIT 3;
